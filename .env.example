NETBOX_API_TOKEN=your_netbox_api_token_here

# LibreNMS Configuration
LIBRENMS_URL=http://192.168.88.243:18082
LIBRENMS_API_TOKEN=your_librenms_api_token_here

# Network Environment
# 主路由
ROUTER_HOST=192.168.88.1
ROUTER_USER=admin
ROUTER_PASSWORD=

# Running MSF test/compatibility gateway
MSF_HOST=192.168.88.222
MSF_FAKE_IP_CIDR=28.0.0.0/8

# OpenClash compatibility gateway (per-device exceptions only)
