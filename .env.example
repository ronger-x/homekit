# NETBOX Configuration
# NETBOX v4.x v2 Token: use "Authorization: Bearer <token>" (not "Token")
NETBOX_URL=http://192.168.88.243:8001
NETBOX_API_TOKEN=your_netbox_api_token_here

# LibreNMS Configuration
LIBRENMS_URL=http://192.168.88.243:18082
LIBRENMS_API_TOKEN=your_librenms_api_token_here

# Network Environment
# 主路由
ROUTER_HOST=192.168.88.1
ROUTER_USER=admin
ROUTER_PASSWORD=

# OpenClash Gateway
OPENCLASH_HOST=192.168.88.4

# Monitoring & Alerting (可选)
# ALERT_EMAIL=admin@example.com
# ALERT_WEBHOOK=

# Database (如果需要直接访问)
