# NETBOX Configuration
# NETBOX v4.x v2 Token: use "Authorization: Bearer <token>" (not "Token")
NETBOX_URL=http://192.168.88.243:8001
NETBOX_API_TOKEN=your_netbox_api_token_here

# LibreNMS Configuration
LIBRENMS_URL=http://192.168.88.243:18082
LIBRENMS_API_TOKEN=your_librenms_api_token_here

# Network Environment
# 主路由
ROUTER_HOST=192.168.88.1
ROUTER_USER=admin
ROUTER_PASSWORD=

# OpenClash Gateway (Legacy)
OPENCLASH_HOST=192.168.88.4

# OSPF Split Routing
OSPF_ROUTER_HOST=192.168.88.250
OSPF_ROUTER_USER=root
OSPF_PASSWORD=YourStrongOSPFPassword123

# sing-box Configuration
SINGBOX_SUBSCRIPTION_URL=http://your-subscription-service/path/to/subscription?target=sing-box

# WireGuard tunnel endpoint (for nchnroutes exclusion)
WIREGUARD_SERVER_IP=

# PVE Host
PVE_HOST=192.168.88.228
PVE_USER=root

# Monitoring & Alerting (可选)
# ALERT_EMAIL=admin@example.com
# ALERT_WEBHOOK=

# Database (如果需要直接访问)
# NETBOX_DB_HOST=192.168.88.243
# NETBOX_DB_PORT=5432
# NETBOX_DB_NAME=netbox
# NETBOX_DB_USER=netbox
# NETBOX_DB_PASSWORD=
